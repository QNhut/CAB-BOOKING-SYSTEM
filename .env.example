# ===========================
# DATABASE CONFIGURATION
# ===========================
POSTGRES_USER=taxi
POSTGRES_PASSWORD=taxi_pass
POSTGRES_DB=taxi_main
POSTGRES_PORT=5432

# ===========================
# DATABASE URLs (for services)
# ===========================
AUTH_DATABASE_URL=postgres://taxi:taxi_pass@postgres:5432/auth_db
BOOKING_DATABASE_URL=postgres://taxi:taxi_pass@postgres:5432/taxi_main
RIDE_DATABASE_URL=postgres://taxi:taxi_pass@postgres:5432/ride_db

# ===========================
# REDIS CONFIGURATION
# ===========================
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ===========================
# KAFKA CONFIGURATION
# ===========================
KAFKA_HOST_PORT=9094
KAFKA_ADVERTISED_HOST=localhost
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=taxi.events
KAFKA_BOOKING_TOPIC=taxi.bookings
KAFKA_RIDE_TOPIC=taxi.rides
KAFKA_PAYMENT_TOPIC=taxi.payments
KAFKA_PARTITIONS=3
KAFKA_GROUP_ID=notification-service
BOOKING_CONSUMER_GROUP_ID=booking-service
RIDE_GROUP_ID=ride-service
NOTIF_GROUP_ID=notification-service
DRIVER_CLIENT_GROUP_ID=driver-client
DRIVER_CLIENT_ID=d1

# ===========================
# SERVICE PORTS
# ===========================
AUTH_PORT=8001
PRICING_PORT=8002
BOOKING_PORT=8003
DRIVER_PORT=8004
RIDE_PORT=8005
NOTIF_PORT=8006
GEO_PORT=8007
PAYMENT_PORT=8888
API_GATEWAY_PORT=8000
ETA_PORT=8009
FRAUD_PORT=8010
REVIEW_PORT=8011
AGENT_PORT=8012
USER_PORT=8013
FRONTEND_PORT=5173
REDIS_PORT=6379
POSTGRES_PORT=5432
PGADMIN_PORT=5050

# ===========================
# JWT CONFIGURATION
# ===========================
JWT_SECRET=dev-secret-change-in-production-please
JWT_ACCESS_TTL=86400
JWT_REFRESH_TTL=2592000
BCRYPT_ROUNDS=10

# ===========================
# DRIVER SERVICE CONFIGURATION
# ===========================
HB_TTL_SEC=60
STATE_TTL_SEC=1800
OFFER_TIMEOUT_SEC=30
DRIVER_RETRY_INTERVAL_SEC=10
DRIVER_RETRY_MAX_ATTEMPTS=12

# ===========================
# GEO SERVICE CONFIGURATION
# ===========================
GEOAPIFY_API_KEY=17a37b3dc4944b038aafa7208f39277d
GEO_DEFAULT_LANG=vi
GEO_DEFAULT_COUNTRY=vn
OSRM_BASE_URL=https://router.project-osrm.org

# ===========================
# INTERNAL SERVICE URLS
# ===========================
AUTH_URL=http://auth-service:8001
BOOKING_URL=http://booking-service:8003
PRICING_URL=http://pricing-service:8002
DRIVER_URL=http://driver-service:8004
RIDE_URL=http://ride-service:8005
NOTIF_URL=http://notification-service:8006
GEO_URL=http://geo-service:8007
PAYMENT_URL=http://payment-service:8888
ETA_URL=http://eta-service:8009
FRAUD_URL=http://fraud-service:8010
REVIEW_URL=http://review-service:8011
AGENT_URL=http://agent-service:8012
USER_URL=http://user-service:8013

# ===========================
# FRONTEND URLS
# ===========================
VITE_AUTH_URL=http://localhost:8000
VITE_BOOKING_URL=http://localhost:8000
VITE_PRICING_URL=http://localhost:8000
VITE_DRIVER_URL=http://localhost:8000
VITE_RIDE_URL=http://localhost:8000
VITE_NOTIFICATION_URL=http://localhost:8000
VITE_GEO_URL=http://localhost:8000
VITE_PAYMENT_URL=http://localhost:8000
VITE_ETA_URL=http://localhost:8000
VITE_REVIEW_URL=http://localhost:8000

# ===========================
# BOOKING SERVICE CONFIGURATION
# ===========================
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=20
REVIEW_DATABASE_URL=postgres://taxi:taxi_pass@postgres:5432/taxi_main
USER_DATABASE_URL=postgres://taxi:taxi_pass@postgres:5432/taxi_main

# ===========================
# PGADMIN CONFIGURATION
# ===========================
PGADMIN_DEFAULT_EMAIL=admin@taxi.com
PGADMIN_DEFAULT_PASSWORD=admin

# ===========================
# IMAGE REPOSITORY (Production)
# ===========================
IMAGE_REPO=your-org/taxi-services
IMAGE_TAG=latest

# ===========================
# GENERAL CONFIGURATION
# ===========================
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
