      "name": "LEVEL 1 – Basic API & Flow",
      "item": [
        {
          "name": "TC01 – Đăng ký user thành công",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"123456\",\n  \"name\": \"Test User\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC01 – HTTP 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('TC01 – Có user_id trong response', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('user_id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC02 – Đăng nhập trả JWT hợp lệ",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"123456\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC02 – HTTP 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('TC02 – Có access_token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('access_token');",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "});",
                  "pm.test('TC02 – JWT decode hợp lệ (có exp và sub)', () => {",
                  "  const json = pm.response.json();",
                  "  const parts = json.access_token.split('.');",
                  "  pm.expect(parts).to.have.lengthOf(3);",
                  "  const payload = JSON.parse(atob(parts[1]));",
                  "  pm.expect(payload).to.have.property('sub');",
                  "  pm.expect(payload).to.have.property('exp');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "TC03 – Tạo booking với input hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickup\": {\"lat\": 10.76, \"lng\": 106.66},\n  \"drop\": {\"lat\": 10.77, \"lng\": 106.70},\n  \"distance_km\": 5\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('TC03 – HTTP 200 hoặc 201', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "pm.test('TC03 – Có booking_id', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('booking_id');",
                  "  pm.collectionVariables.set('bookingId', json.booking_id);",
                  "});",
                  "pm.test('TC03 – Status là REQUESTED hoặc CONFIRMED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(['REQUESTED','CONFIRMED']).to.include(json.status);",
