      "name": "Setup – Login (auto)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Set token OUTSIDE pm.test() so it is always saved even if assertions fail",
              "const respJson = pm.response.json();",
              "const tok = respJson.access_token || respJson.accessToken;",
              "if (tok) pm.collectionVariables.set(\"token\", tok);",
              "",
              "pm.test(\"Setup: Login 200 OK\", () => {",
              "  pm.expect(pm.response.code).to.equal(200);",
              "  pm.expect(tok).to.not.be.undefined;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"user@test.com\", \"password\": \"123456\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
